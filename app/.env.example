# NoteHive · environment (PRD 8.2). Copy to .env.local.

# true (default): in-memory demo data and demo sign-in, no Supabase or n8n needed.
# false: real Supabase auth/data and n8n AI workflows.
USE_MOCKS=true

# Web app · Supabase (browser holds only the anon key; RLS guards everything)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only · used by /api/ask to store answers (RLS: insert via server path only)
SUPABASE_SERVICE_ROLE_KEY=

# Web app · n8n (AI keys live in n8n, never here)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Webhook names in the "KH · core" workflow (called as {N8N_BASE_URL}/webhook/<name>)
N8N_ASK_WEBHOOK=kh-ask
N8N_ORGANISE_WEBHOOK=kh-organise-note

# Product
DEFAULT_GROUP_NAME=Community
ASK_RATE_LIMIT_PER_HOUR=30
